# Required database credentials. Keep app and Postgres values aligned.
SPRING_DATASOURCE_USERNAME=contactwork
SPRING_DATASOURCE_PASSWORD=change-me

# First admin account seed. Login and password are required for initial access.
CONTACTWORK_ADMIN_LOGIN=admin
CONTACTWORK_ADMIN_PASSWORD=change-me
CONTACTWORK_ADMIN_NAME=ContactWork Admin
CONTACTWORK_ADMIN_EMAIL=admin@<DOMAIN>

# Local AI runtime. Ollama remains the default provider.
LOCAL_AI_MODEL=gemma4:e2b

# Optional Google GenAI provider.
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-2.0-flash
GOOGLE_GENAI_TEMPERATURE=0.2

# Optional Brave Search tool for AI-assisted research.
BRAVE_SEARCH_API_KEY=

# Google OAuth for Gmail sender alias sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.<DOMAIN>/callback

# Gmail folder names used by reply/sent/spam synchronization.
GMAIL_INBOX_FOLDER=INBOX
GMAIL_SENT_FOLDER=[Gmail]/Sent Mail
GMAIL_SPAM_FOLDER=[Gmail]/Spam

# ONLYOFFICE browser and container network URLs.
ONLYOFFICE_PUBLIC_BASE_URL=https://docs.<DOMAIN>
ONLYOFFICE_DOCUMENT_BASE_URL=http://app:8083
ONLYOFFICE_INTERNAL_DOWNLOAD_BASE_URL=http://onlyoffice
ONLYOFFICE_CONVERTER_BASE_URL=http://onlyoffice
ONLYOFFICE_ACCESS_SECRET=change-me-long-random-secret
